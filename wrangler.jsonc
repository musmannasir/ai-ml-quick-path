{
  // Cloudflare Workers configuration for the static site. Cloudflare's own Git build (Workers Builds) reads this file:
  // it runs "npm run build", then "npx wrangler deploy", which publishes the dist/ folder.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-ml-quick-path",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
